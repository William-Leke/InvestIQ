PORT=8787
# Comma-separated origins allowed to call the API (Tauri dev server and app).
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# Financial Modeling Prep. Paying users need FMP's commercial redistribution license.
FMP_API_KEY=
# SEC requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT=InvestIQ admin@example.com

# Auth: "dev" skips sign-in and billing checks (local only). "clerk" verifies Clerk session JWTs.
AUTH_MODE=dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
CHECKOUT_SUCCESS_URL=https://investiq.app/billing/success
CHECKOUT_CANCEL_URL=https://investiq.app/billing/cancel

DB_PATH=./investiq.db
